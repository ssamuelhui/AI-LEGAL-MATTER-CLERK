# Secrets
.env
*.key

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp

# Vector DB persistent storage
data/chroma/
qdrant_storage/

# Matter persistence (contains confidential matter data; never commit)
matter_clerk.db
*.db
*.db-journal
*.db-wal

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Test outputs
test-output/
.pytest_cache/

# Generated export files from verify_exports.py --keep (may embed matter text)
tests/acceptance/_export_output/

# User data (matters are confidential; never commit)
data/matters/
data/test_matter/
data/adversarial_matter/

# But DO commit the directory structure
!data/.gitkeep
!data/test_matter/.gitkeep
!data/adversarial_matter/.gitkeep

# Phase 3 Session 3 packaging artifacts.
# vendor/ (~98 MB of Tesseract + Poppler) and models/ (~133 MB of ONNX
# weights) are large binaries reproducible from scripts/stage_vendor.ps1 and
# scripts/fetch_model.ps1. vendor/VERSIONS.txt records the exact upstream
# versions, so the build stays reproducible without committing the binaries.
vendor/
models/

# Data-directory layout marker, written at first run (in a source checkout
# the data directory is the repo root).
/version.txt

# Session 5: compiled installer (~197 MB, rebuildable from the bundle).
installer/output/

# Session 6a/7 runtime state written into the data directory (which is the
# repo root in a source checkout).
/ui_prefs.json
/update_check.json
/notices.json
/migrations/
matter-clerk-diagnostic-*.json

# Session 8 background run state (data directory = repo root in a checkout).
/runs/
