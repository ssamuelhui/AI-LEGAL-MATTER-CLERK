# Copy this file to .env and fill in your values.
# Never commit .env to git.

# OpenRouter API key for MiMo Pro access.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model identifier. Default is MiMo Pro per the SoW.
# To switch to Claude for testing: anthropic/claude-opus-4-7
MODEL=xiaomi/mimo-v2.5-pro

# Vector store location. ChromaDB runs EMBEDDED -- no Docker, no daemon, no
# ports. Leave blank to use <repo>/data/chroma.
# CHROMA_DB_PATH=

# Embedding model (runs locally on CPU via ONNX Runtime).
# The packaged build bundles this model's weights and can serve no other --
# naming a different model raises rather than silently embedding with the
# bundled one. Leave as-is unless you are also changing what gets bundled.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# CanLII API key (optional; if blank, the tool uses unauthenticated CanLII access with rate-limit respect)
CANLII_API_KEY=

# Where the application writes matter_clerk.db, data/matters, data/chroma
# and logs. Unset: the repo root when running from source, and
# %LOCALAPPDATA%\MatterClerk when running the packaged build.
# MATTER_CLERK_DATA_DIR=

# Port for the local web UI (default 5050).
# MATTER_CLERK_PORT=5050
