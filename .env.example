# Copy this file to .env and fill in your values.
# Never commit .env to git.

# OpenRouter API key for MiMo Pro access.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model identifier. Default is MiMo Pro per the SoW.
# To switch to Claude for testing: anthropic/claude-opus-4-7
MODEL=xiaomi/mimo-v2.5-pro

# Vector database connection (Qdrant in Docker)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Embedding model (runs locally on CPU)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# CanLII API key (optional; if blank, the tool uses unauthenticated CanLII access with rate-limit respect)
CANLII_API_KEY=
